  </link>
  <joint name="lidar_mount_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_mount"/>
    <origin xyz="0.1 0 0.10842"/>
  </joint>
  <!-- lidar_link origin is the scan plane: 18 mm mount + 32 mm to the optical centre -->
  <link name="lidar_link">
    <inertial>
      <mass value="0.19"/>
      <inertia ixx="1e-4" ixy="0" ixz="0" iyy="1e-4" iyz="0" izz="1e-4"/>
    </inertial>
    <visual>
      <origin xyz="0 0 -0.032"/>
      <geometry>
        <mesh filename="package://amr_description/meshes/mounts/lidar_body.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="amr_black">
        <color rgba="0.05 0.05 0.06 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 -0.013"/>
      <geometry>
        <cylinder length="0.038" radius="0.035"/>
      </geometry>
    </collision>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="lidar_mount"/>
    <child link="lidar_link"/>
    <origin xyz="0 0 0.050"/>
  </joint>
  <link name="camera_mount">
    <inertial>
      <origin xyz="0 0 0.01"/>
      <mass value="0.015"/>
      <inertia ixx="3e-6" ixy="0" ixz="0" iyy="3e-6" iyz="0" izz="3e-6"/>
    </inertial>
    <visual>
      <geometry>
        <mesh filename="package://amr_description/meshes/mounts/camera_mount.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="amr_mount">
        <color rgba="0.18 0.19 0.20 1"/>
      </material>
    </visual>
  </link>
  <joint name="camera_mount_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_mount"/>
    <origin xyz="0.1375 0 0.10842"/>
  </joint>
  <!-- camera_link: x along the lens, tilted 15 degrees down -->
  <link name="camera_link">
    <inertial>
      <mass value="0.02"/>
      <inertia ixx="2e-6" ixy="0" ixz="0" iyy="2e-6" iyz="0" izz="2e-6"/>
    </inertial>
    <visual>
      <origin xyz="-0.0045 0 0"/>
      <geometry>
        <mesh filename="package://amr_description/meshes/mounts/camera_body.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="amr_black">
        <color rgba="0.05 0.05 0.06 1"/>
      </material>
    </visual>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="camera_mount"/>
    <child link="camera_link"/>
    <origin rpy="0 0.2617993877991494 0" xyz="0.0065 0 0.020"/>
  </joint>
  <link name="camera_optical_frame"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_frame"/>
    <origin rpy="-1.5707963267948966 0 -1.5707963267948966"/>
  </joint>
  <!-- Front-face branding: visual only, meshes are in the base_link frame (make_mounts.py) -->
  <link name="branding">
    <inertial>
      <mass value="0.001"/>
      <inertia ixx="1e-7" ixy="0" ixz="0" iyy="1e-7" iyz="0" izz="1e-7"/>
    </inertial>
    <visual>
      <geometry>
        <mesh filename="package://amr_description/meshes/mounts/brand_name.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="amr_brand_blue">
        <color rgba="0.08 0.27 0.50 1"/>
      </material>
    </visual>
    <visual>
      <geometry>
        <mesh filename="package://amr_description/meshes/mounts/brand_author.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="amr_brand_dark">
        <color rgba="0.18 0.19 0.20 1"/>
      </material>
    </visual>
  </link>
  <joint name="branding_joint" type="fixed">
    <parent link="base_link"/>
    <child link="branding"/>
  </joint>
</robot>
